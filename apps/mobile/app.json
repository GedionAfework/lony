{
  "expo": {
    "name": "Lony",
    "slug": "lony",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "lony",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.lony.app",
      "infoPlist": {
        "NSContactsUsageDescription": "Lony uses contacts so you can find friends by phone and invite them to a loan.",
        "NSMicrophoneUsageDescription": "Lony uses the microphone so you can send voice notes in chat.",
        "NSFaceIDUsageDescription": "Lony uses Face ID to unlock the app when Biometrics Lock is on.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "io.lony.app",
      "softwareKeyboardLayoutMode": "resize",
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_SMS",
        "android.permission.RECEIVE_SMS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.WRITE_CONTACTS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "lony"
            }
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Lony to use Face ID to unlock the app."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Lony to use the microphone for voice notes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Lony to access photos for your profile picture, repayment proofs, and receipt scans.",
          "cameraPermission": "Allow Lony to use the camera to scan receipts and bank statements."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Lony to access contacts so you can find friends by phone."
        }
      ],
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "d6dd1164-155d-4177-9b8a-82c50fd7d709"
      }
    },
    "owner": "gedionafework"
  }
}
