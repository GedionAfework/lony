{
  "expo": {
    "name": "Lony",
    "slug": "lony",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "lony",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.lony.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF"
      },
      "package": "io.lony.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "lony"
            }
          ]
        }
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "expo-audio",
      [
        "expo-notifications",
        {
          "color": "#0D9488"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Lony to access photos for your profile picture and repayment proofs."
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
