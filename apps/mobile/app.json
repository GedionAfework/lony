{
  "expo": {
    "name": "Lony",
    "slug": "lony",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "lony",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.lony.app",
      "infoPlist": {
        "NSContactsUsageDescription": "Lony uses contacts so you can find friends by phone and invite them to a loan."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF"
      },
      "package": "io.lony.app",
      "permissions": ["READ_CONTACTS"],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [{ "scheme": "lony" }]
        }
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Lony to access photos for your profile picture and repayment proofs."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Lony to access contacts so you can find friends by phone."
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
