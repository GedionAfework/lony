{
  "expo": {
    "name": "Lony",
    "slug": "lony",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.lony.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF"
      },
      "package": "io.lony.app"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "expo-audio"
    ]
  }
}
