# Mobile (Expo) — copy to apps/mobile/.env
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1

# Google OAuth (Web client ID also works for Expo AuthSession id_token)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# After `eas init`, paste the project UUID here and into app.json → extra.eas.projectId
EXPO_PUBLIC_EAS_PROJECT_ID=
