APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://equilend:equilend@127.0.0.1:5432/equilend?sslmode=disable
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=dev-only-change-me-to-at-least-32-chars
BANK_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
VERIFICATION_CODE_TTL=10m
MEDIA_DIR=

# OAuth (optional in development)
GOOGLE_CLIENT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Email — prefer Resend; otherwise SMTP. In development with neither set, codes are logged and returned in the API response.
RESEND_API_KEY=
MAIL_FROM=Lony <noreply@yourdomain.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Expo push (optional; LogPusher used when empty)
EXPO_ACCESS_TOKEN=
